# 344  - Reverse String (String)
# Write a function that reverses a string. The input string is given as an array of characters s

"""
Example 1:
Input: s = ["h","e","l","l","o"]
Output: ["o","l","l","e","h"]

Example 2:
Input: s = ["H","a","n","n","a","h"]
Output: ["h","a","n","n","a","H"]
"""

# 1st way ( using loop and list adding (extra space) in result list )

#  O(N)extra space

"""
lst = ["h","e","l","l","o"]
temp = lst.copy()                            # copy only the values

i = 0
while len(temp) > 0:
    lst[i] = temp.pop()            # modify original ( add the popped/last element of temp in original )
                                   # decrement temp and add that value in original
    i+=1
print(lst)
"""

# 2nd way ( using two pointer --> correct and best approach with O(1) space )

lst = ["h","e","l","l","o"]

l=0
r=len(lst) - 1

while l < r:
    lst[l] , lst[r] = lst[r],lst[l]
    l+=1
    r-=1
print(lst)
