# 3rd way ( using while loop --> better than for loop )

# In while loop , we can avoid unwanted loops too , like if we get ( then check next if 'a',we can update i += 4
# where it reduces the no of loops.

command = "(al)G(al)()()G"
res = ""
i = 0

while i < len(command):
    if command[i] == 'G':
        res += 'G'
        i += 1
    elif command[i:i + 2] == "()":
        res += 'o'
        i += 2
    else:
        res += 'al'
        i += 4

print(res)
