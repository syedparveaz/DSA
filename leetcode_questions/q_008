# 136. single number

"""
Given a non-empty array of integers nums, every element appears twice except for one. Find that single one.

You must implement a solution with a linear runtime complexity and use only constant extra space.

# Input: nums = [2,2,1]
# Output: 1

"""

# 1st way ( brute force )

"""

nums = [2,3,4,5,2,3,5]
out = 0

for i in nums:
    if nums.count(i) == 1:
        out+=i
print(out)

"""

# 2nd way ( using hashmap / dict )

"""
nums = [2,3,4,5,2,3,5]
d={}

for i in nums:
    if i in d:
        d[i]+=1
    else:
        d[i]=1

for k in d:
    if d[k] == 1:
        print(k)
"""

# 3rd way ( using xor )
"""
a ^ a = 0
a ^ 0 = a
XOR is commutative & associative
"""

nums = [2,3,4,5,2,3,5]
res = 0

for i in nums:
    res = res ^ i
print(res)

