
# 1929. Concatenation of Array

"""
Input: nums = [1,2,1]
Output: [1,2,1,1,2,1]
Explanation: The array answer is formed as follows:
- ans = [nums[0],nums[1],nums[2],nums[0],nums[1],nums[2]]
- ans = [1,2,1,1,2,1]
"""

# 1st way ( create a list and modify in standard way )

"""
nums = [1,2,3,4,5]
l = len(nums)                      # 5
out = [0] * (len(nums)*2)

for i in range(len(nums)):                # dry run --> i=0
    out[i] = nums[i]               # out[0] = 1 
    out[i+l] = nums[i]             # out[0 + 5 ] = 1              --> assigning twice
print(out)
"""

# 2nd way (create the double len of list and modify)

"""
nums = [1,2,3]
temp = nums * 2
out = [0] * (len(nums)*2)

for i in range(len(out)):
    out[i] = temp[i]
print(out)
"""


# 3rd way ( just append twice --> simple dsa )

num = [1,2,3]
out = []

for i in num:
    out.append(i)
for repeat in num:
    out.append(repeat)
print(out)


