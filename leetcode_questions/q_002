
# 9. Palindrome Number

# check whether a number is palindrome or not

def isPalindrome(x):

    temp = x
    rev = 0

    while x > 0:
        rem = x % 10
        rev = rev *10 + rem
        x//=10
    if temp == rev:
        return True
    else:
        return False

num = int(input("X:"))
print(isPalindrome(num))
