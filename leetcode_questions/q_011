n = [12, 22, 2121, 222,2,97772]
count = 0

for i in n:
    no_of_digits = 0

    temp = i
    while temp > 0:
        temp = temp // 10                  # divide
        no_of_digits += 1

    if no_of_digits % 2 == 0 :
        count+=1

print(count)

