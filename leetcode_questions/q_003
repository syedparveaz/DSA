# 344. Reverse a string

# input =  ['h', 'e', 'l', 'l', 'o']       # dtype = list
# output = ['o', 'l', 'l', 'e', 'h']       # dtype = list

# 1st way ( using two pointers )

def reverseString(s):
    """
    :type s: List[str]
    :rtype: None Do not return anything, modify s in-place instead.
    """
    l, r = 0, len(s) - 1
    while l < r:
        s[l], s[r] = s[r], s[l]
        l += 1
        r -= 1
    return s

word = list(input('S:'))
print(reverseString(word))

# ----> using two pointers (left as l and right as r)

# 1. Take input and convert it into a list
# 2. Initialize two pointers
# 3. Swap characters while l < r   ( till mid )
# 4. Stop when l >= r 
# 5. Function returns the reversed list ( even though it modifies in place )


